# ==============================================================================
# MENE TOOLS - ENVIRONMENT VARIABLES CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to `apps/web/.env.local` for web application development.
# For Cloudflare Worker AI Gateway development, see `services/ai-gateway/.dev.vars.example`.

# 1. FRONTEND ENVIRONMENT VARIABLES (apps/web)
# NEXT_PUBLIC_AI_GATEWAY_URL: The URL where your AI Gateway Cloudflare Worker (or local wrangler worker) is hosted.
# Default for local development: http://127.0.0.1:8787
NEXT_PUBLIC_AI_GATEWAY_URL="http://127.0.0.1:8787"

# 2. BACKEND / WORKER SECRETS (services/ai-gateway)
# GROQ_API_KEY: Required for Groq AI API calls. Set via `npx wrangler secret put GROQ_API_KEY` in production.
# In local development, add to `services/ai-gateway/.dev.vars`.
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"
