# ==========================================
# ENTERPRISE GITIGNORE - MENE-TOOLS MONOREPO
# ==========================================

# --- Dependencies & Package Manager Files ---
node_modules/
/media/
jspm_packages/
web_modules/
.pnpm-store/
.bun/
# In case yarn or pnpm is used elsewhere in workspace
.yarn/
yarn-error.log*
pnpm-debug.log*

# --- Lockfiles ---
# Keep package-lock.json, but ignore bun.lock if we are standardizing on npm
bun.lock
bun.lockb

# --- Build Outputs & Caches ---
dist/
build/
out/
.next/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.tsbuildinfo
tsconfig.tsbuildinfo

# --- Testing & Coverage ---
coverage/
.nyc_output/
.playwright/
html-report/
test-results/

# --- Cloudflare Wrangler & Serverless ---
.wrangler/
.dev.vars
wrangler-debug.log*

# --- Environment & Secret Files (CRITICAL) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.pub
# Credentials and GCP service accounts keys
*credentials*.json
*key*.json
*.keystore
!google-services.json

# --- IDEs and Text Editors ---
# JetBrains (IntelliJ IDEA, WebStorm, PyCharm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.history/
*.code-workspace

# OS-specific files (System Garbage)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*
